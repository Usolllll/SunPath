# MySQL 8: create database first; URL-encode special characters in credentials.
DATABASE_URL=mysql+pymysql://sunpath:YOUR_PASSWORD@127.0.0.1:3306/sunpath?charset=utf8mb4
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Used ONLY by explicit python -m app.seed, never by server startup.
DEMO_EMAIL=demo@sunpath.cn
DEMO_PASSWORD=Sunpath2026!

# All LLM integrations use this one OpenAI-compatible gateway; keep keys server-side only.
# 示例 A（默认，免注册公共通道，最慢但零成本，适合演示）：
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://text.pollinations.ai/openai
DEEPSEEK_MODEL=openai-fast
DEEPSEEK_MODEL_LABEL=GPT-OSS-20B（免费公共通道）
DEEPSEEK_TIMEOUT_SECONDS=150
#
# 示例 B（智谱 GLM-4-Flash，免费但需手机号注册拿 Key，速度快；更推荐日常使用）：
# DEEPSEEK_API_KEY=<智谱 API Key>
# DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSEEK_MODEL=glm-4-flash
# DEEPSEEK_MODEL_LABEL=GLM-4-Flash（免费）
# DEEPSEEK_TIMEOUT_SECONDS=60
#
# 示例 C（ModelScope 魔搭免费推理，送每日额度，模型可选 Qwen2.5-72B）：
# DEEPSEEK_API_KEY=<魔搭 access token>
# DEEPSEEK_BASE_URL=https://api-inference.modelscope.cn/v1
# DEEPSEEK_MODEL=Qwen/Qwen2.5-72B-Instruct
# DEEPSEEK_MODEL_LABEL=Qwen2.5-72B（魔搭免费额度）
#
# 示例 D（DeepSeek 官方，按量计费，最稳）：
# DEEPSEEK_API_KEY=<platform.deepseek.com 的 Key>
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL_LABEL=DeepSeek-V3.2

# 天地图「浏览器端」Key（部署方在自己账号下申请）：改这里后只需重启后端，前端无需重新构建。
# 未配置时前端地图显示「服务待启用」，不影响院校列表与查询。
TIANDITU_WEB_KEY=
# 地图来源：auto（默认，无 Key 用内置示意底图）/ schematic（强制内置底图）/ tianditu（强制天地图）
MAP_PROVIDER=auto
ADMIN_EMAILS=["demo@sunpath.cn"]
