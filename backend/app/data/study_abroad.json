  "_meta": {
    "purpose": "留学规划模块的院校索引与官方申请入口（FR-M11-01）。",
    "updated_at": "2026-11",
    "data_mode": "参考索引",
    "note": "语言分数为学校官网公布的常见最低要求的参考值，可能随专业与年份变化；申请要求、截止日期与材料清单一律以学校官网为准。本文件只做官方入口索引，不抓取、不代填申请表。",
    "language_hint": "英国/香港/新加坡的本科项目通常要求提供雅思或托福成绩；美国院校另需 SAT/ACT 等标化与文书材料。语言成绩不达标时，部分学校提供预科或语言班，需以官网说明为准。",
    "pathways": [
      {
        "code": "gaokao",
        "label": "准备或已参加高考（用高考成绩申请）",
        "summary": "以高考成绩 + 语言成绩申请接受高考的院校；不同国家/学校对高考成绩与英语单科的认可度差异很大。",
        "note": "只把高考成绩作为申请材料之一，是否接受、分数门槛与英语单科要求以学校官网当年说明为准。"
      },
      {
        "code": "post_gaokao",
        "label": "高考后才决定留学（预科 / 国际大一）",
        "summary": "高考后再转向留学，常见路径是预科（Foundation）或国际大一（International Year One），用高中成绩与语言成绩申请。",
        "note": "预科/国际大一通常有升学考核，能否进入目标学位课程取决于成绩，不等于直接录取。"
      },
      {
        "code": "international",
        "label": "放弃国内高考，读国际课程（A-Level / IB / AP 等）",
        "summary": "以国际课程成绩申请，英国走 UCAS、美国走 Common App/学校官网；语言成绩仍是硬门槛。",
        "note": "国际课程体系与选课会影响可申请专业，需提前按目标专业规划。"
      }
    ],
