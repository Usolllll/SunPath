  "timeline": [
    {
      "type": "高考报名",
      "window": "前一年10—11月，各省组织网上报名、资格审核与信息确认，具体时间以本省考试院公告为准",
      "source": "教育部年度招生工作通知 / 省级教育考试院",
      "source_url": "http://www.moe.gov.cn/srcsite/A15/moe_776/s3258/202601/t20260121_1427110.html"
    },
    {
      "type": "强基计划",
      "window": "每年4月发布简章并网上报名，4月底截止；6月高考后参加校考，7月初公布录取结果",
      "source": "教育部/高校强基计划简章，阳光高考平台汇总",
      "source_url": "https://gaokao.chsi.com.cn/gkxx/qjjh/202604/20260407/2293459502-7.html"
    },
    {
      "type": "综合评价",
      "window": "3—5月各校发布简章、提交报名材料并组织校测，时间逐校不同，须以当年简章为准",
      "source": "阳光高考特殊类型招生信息服务平台 / 高校综评简章",
      "source_url": "https://gaokao.chsi.com.cn/gkzt/tszs"
    },
    {
      "type": "专项计划",
      "window": "4月前后报名与资格审核（国家专项、地方专项、高校专项），要求户籍、学籍连续满3年等条件",
      "source": "教育部年度招生工作通知 教学〔2026〕1号",
      "source_url": "http://www.moe.gov.cn/srcsite/A15/moe_776/s3258/202601/t20260121_1427110.html"
    },
    {
      "type": "志愿填报",
      "window": "6月下旬公布成绩后至7月初，按省考试院安排分批次网上填报并确认，逾期不予补报",
      "source": "省级教育考试院 / 教育部年度招生工作通知",
      "source_url": "http://www.moe.gov.cn/srcsite/A15/moe_776/s3258/202601/t20260121_1427110.html"
    },
    {
      "type": "录取",
      "window": "7月上旬起分批次投档录取，结果由省级考试院与高校招生网公布，注意各批次征集志愿时间",
      "source": "省级教育考试院 / 高校本科招生网",
      "source_url": "http://www.moe.gov.cn/srcsite/A15/moe_776/s3258/202601/t20260121_1427110.html"
    },
    {
      "type": "入学报到复查",
      "window": "8月下旬至9月按录取通知书报到；入学后3个月内进行资格与体检复查，不合格可能调整专业或取消学籍",
      "source": "《普通高等学校学生管理规定》（教育部令第41号）第八条、第十一条",
      "source_url": "https://www.gov.cn/gongbao/content/2017/content_5220900.htm"
    }
